{
  "manifest_version": 3,
  "name": "Amazonize Rakuten",
  "version": "2026.9.16",
  "description": "楽天市場をAmazon風のシンプルなUIに。商品ページにAmazonでの価格を表示。クーポン獲得・かご合計・最適クーポン自動適用・キャンペーン自動エントリー。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://*.rakuten.co.jp/*",
    "https://www.amazon.co.jp/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Amazonize Rakuten"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rakuten.co.jp/*",
        "https://item.rakuten.co.jp/*",
        "https://search.rakuten.co.jp/*",
        "https://cart.step.rakuten.co.jp/*",
        "https://*.basket.step.rakuten.co.jp/*",
        "https://basket.step.rakuten.co.jp/*",
        "https://step.item.rakuten.co.jp/*",
        "https://order.step.rakuten.co.jp/*",
        "https://coupon.rakuten.co.jp/*",
        "https://event.rakuten.co.jp/*"
      ],
      "js": [
        "src/lib/settings.js",
        "src/lib/dom.js",
        "src/lib/coupon-model.js",
        "src/lib/amazon-match.js",
        "src/content/boot.js",
        "src/content/top.js",
        "src/content/item-images.js",
        "src/content/item-gallery.js",
        "src/content/item-coupons.js",
        "src/content/item.js",
        "src/content/item-amazon.js",
        "src/content/search.js",
        "src/content/cart.js",
        "src/content/coupon.js",
        "src/content/checkout.js",
        "src/content/campaign.js"
      ],
      "css": [
        "src/styles/common.css",
        "src/styles/item.css",
        "src/styles/amazon.css",
        "src/styles/cart.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://cart.step.rakuten.co.jp/*"
      ],
      "js": ["src/content/state-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://item.rakuten.co.jp/*"
      ],
      "js": ["src/content/video-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
